# Study Engine settings. Restart Study Engine after changing this file.

# Optional. With an Anthropic API key, answers are checked by Claude and you can check your
# own writing. Without one, Study Engine runs in demo mode with its sample answers.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. The port Study Engine runs on (the next free one is used if it's taken).
# PORT=3001

# Optional. The Claude models live AI uses.
# STUDY_ENGINE_MODEL=claude-sonnet-5-5
# STUDY_ENGINE_QUICK_MODEL=claude-haiku-4-5-20251001
